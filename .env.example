# ---------- База данных ----------
DATABASE_URL=postgresql://aqylmed:change_me@localhost:5432/aqylmed_ai_db

# ---------- Безопасность ----------
# Обязательно в production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
# Первый администратор создаётся при старте, если в БД ещё нет пользователей
# (или командой: python -m app.cli create-user --role admin ...)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Языковая модель (Gemini) ----------
GEMINI_API_KEY=your_gemini_key_here
# gemini-2.5-flash выведена из эксплуатации Google (шатдаун 16.10.2026). Проверьте актуальную модель:
#   python -m app.cli check-config
GEMINI_MODEL=gemini-3.5-flash

# ---------- Распознавание речи ----------
STT_PROVIDER=groq            # groq | openai
GROQ_API_KEY=your_groq_key_here
GROQ_STT_MODEL=whisper-large-v3        # или whisper-large-v3-turbo
GROQ_STT_LANGUAGE=ru                   # пусто = автоопределение (для казахского/смешанной речи)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe   # whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe

# ---------- Разделение говорящих (pyannote) ----------
# false = не нужен torch; роли «врач/пациент» определит языковая модель по смыслу реплик
DIARIZATION_ENABLED=true
HF_TOKEN=your_huggingface_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
NUM_SPEAKERS=2

# ---------- Хранение аудио ----------
UPLOAD_DIR=storage/audio
MAX_UPLOAD_MB=100
AUDIO_RETENTION_DAYS=30            # 0 = не удалять автоматически
DELETE_AUDIO_AFTER_PROCESSING=false

# ---------- Расходы ----------
MONTHLY_API_BUDGET_USD=0           # 0 = без лимита; при превышении новые приёмы не обрабатываются
MAX_CONCURRENT_PROCESSING=2
POSTGRES_PASSWORD=change_me_too
